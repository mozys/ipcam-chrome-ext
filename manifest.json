{
  "manifest_version": 3,
  "name": "IPCAM S/N",
  "description": "Render IPCAM serial number as barcode",
  "version": "3.2",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "css": ["css/styles.css"],
      "js": ["scripts/bwip-js-min.js", "scripts/content.js"],
      "matches": [
        "http://*/bis"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}